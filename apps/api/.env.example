HOST=127.0.0.1
PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
MAIL_MODE=file
# Local development mailbox; no real email is sent in file mode.
# MAIL_DIRECTORY=C:/Projects/Task-manager/.local/mail
# For real email: MAIL_MODE=resend, verified MAIL_FROM and RESEND_API_KEY.
# MAIL_FROM=Task Manager <no-reply@example.com>
# RESEND_API_KEY=
# Development credentials only. Keep the password consistent with the root .env.
DATABASE_URL=postgresql://task_manager:task_manager_dev@127.0.0.1:55432/task_manager
